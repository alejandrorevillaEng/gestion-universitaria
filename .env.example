# Copia este fichero a .env y cambia los valores. .env no se sube a git.
DB_PASSWORD=cambia-esta-clave
# Contraseña del usuario admin (mínimo 8 caracteres). Con MySQL es obligatoria: la app no arranca con admin/admin.
ADMIN_PASSWORD=cambia-esta-clave-de-admin
# true carga titulaciones, asignaturas y alumnos de ejemplo si la base de datos está vacía.
DATOS_EJEMPLO=true
