<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración específica de Tomcat. La conexión a la base de datos va por
     variables de entorno (DB_URL, DB_USER, DB_PASSWORD), ver Configuracion.java. -->
<Context>
    <!-- La cookie de sesión no viaja en peticiones iniciadas desde otras webs (defensa extra contra CSRF). -->
    <CookieProcessor sameSiteCookies="lax"/>
    <!-- Detrás de un proxy con HTTPS (Nginx, Render, Fly...): la app sabe que la petición es
         segura, marca la cookie como Secure y envía HSTS. -->
    <Valve className="org.apache.catalina.valves.RemoteIpValve" protocolHeader="X-Forwarded-Proto"/>
    <!-- No guardar sesiones en disco al parar Tomcat. -->
    <Manager pathname=""/>
</Context>
