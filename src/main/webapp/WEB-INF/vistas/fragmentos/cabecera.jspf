<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="${fn:escapeXml(requestScope.csrfToken)}">
    <title><c:out value="${titulo}"/> · Gestión universitaria</title>
    <link rel="stylesheet" href="${ctx}/css/estilos.css">
    <script src="${ctx}/js/app.js" defer></script>
</head>
<body>
<c:if test="${not empty yo}">
<header class="barra">
    <a class="marca" href="${ctx}/asignaturas">Gestión universitaria</a>
    <nav class="menu" aria-label="Secciones">
        <a href="${ctx}/asignaturas" class="${seccion == 'asignaturas' ? 'activo' : ''}">Asignaturas</a>
        <a href="${ctx}/titulaciones" class="${seccion == 'titulaciones' ? 'activo' : ''}">Titulaciones</a>
        <a href="${ctx}/profesores" class="${seccion == 'profesores' ? 'activo' : ''}">Profesores</a>
        <a href="${ctx}/alumnos" class="${seccion == 'alumnos' ? 'activo' : ''}">Alumnos</a>
        <c:if test="${yo.esAdmin()}">
            <a href="${ctx}/estadisticas" class="${seccion == 'estadisticas' ? 'activo' : ''}">Estadísticas</a>
            <a href="${ctx}/usuarios" class="${seccion == 'usuarios' ? 'activo' : ''}">Usuarios</a>
        </c:if>
        <a href="${ctx}/panel-api" class="${seccion == 'api' ? 'activo' : ''}">API REST</a>
    </nav>
    <form class="salir" method="post" action="${ctx}/logout">
        <input type="hidden" name="_csrf" value="${fn:escapeXml(requestScope.csrfToken)}">
        <span class="quien"><c:out value="${yo.nombre}"/><c:if test="${yo.esAdmin()}"> · administrador</c:if></span>
        <button type="submit" class="boton boton-suave">Salir</button>
    </form>
</header>
</c:if>
<main class="contenido">
<c:if test="${not empty sessionScope.flash}">
    <div class="aviso aviso-${sessionScope.flash.tipo}" role="status"><c:out value="${sessionScope.flash.mensaje}"/></div>
    <c:remove var="flash" scope="session"/>
</c:if>
<c:if test="${not empty errorFormulario}">
    <div class="aviso aviso-error" role="alert"><c:out value="${errorFormulario}"/></div>
</c:if>
